.3,-0.7,-1,-1.7,-2,-2,-2,-2,-2,-4,-7,-8.3,-8.7,-8.7,-8,-4,-0.7,-0.7,-0.7,-1.3,-1.7,-1,-1,-1.3,-1,0,1,1,1,1,1,1,1,1.7,1.7,1.3,1.7,4.3,7.7,9.3,8.7,6,1,-4.3,-5.7,-5.7,-5.7,-5.7,-5.7,-5.3,-5,-5,-7.7,-11,-12.7,-13,-11.3,-6.3,-1.3,0,0,0,-0.3,-0.7,-0.3,-0.3,5.3,11.3,11.3,11.3,11.7,11.7,11.3,10.7,9.7,9.7,8.3,6.3,6,6,5.7,-0.3,-6.3,-5.3,-4,-4.7,-5.7,-6,-6,-5.8,-5.6]},"landmarks":[{"at":[35.618,139.7412],"name":"品川宿","kana":"しながわしゅく","kind":"origin","note":"東海道の第一宿。ここの問屋場で荷を継ぐ。北品川・歩行新宿・南品川の三宿からなり、旅籠は九十軒を超えた。","s":0,"x":0,"y":3.64,"z":0,"snapError":0},{"at":[35.6163,139.7414],"name":"品川橋","kana":"しながわばし","kind":"bridge","bridge":{"radiusM":11,"riseM":0.8},"note":"目黒川に架かる橋。この橋を境に北品川と南品川が分かれる。境橋とも呼ばれた。","s":194.99,"x":18.97,"y":3.3,"z":194.06,"snapError":4.9},{"at":[35.6108,139.7424],"name":"青物横丁","kana":"あおものよこちょう","kind":"town","note":"近在の百姓が青物を持ち寄って市を立てた横丁。宿場の台所であり、朝のうちは人が立て込む。","s":809.96,"x":108.5,"y":4.48,"z":801.99,"snapError":0.5},{"at":[35.609,139.742],"name":"品川寺","kana":"ほんせんじ","kind":"temple","gateway":{"width":11,"height":8.5,"side":-1},"note":"大同年間の開創と伝わる古刹。宝永五年(1708)、江戸六地蔵の第一番として丈六の地蔵菩薩が門前に据えられた。旅立つ者はここで手を合わせて発つ。","s":1019.91,"x":70.06,"y":5.12,"z":1008.35,"snapError":6.9},{"at":[35.6054,139.7404],"name":"鮫洲","kana":"さめず","kind":"town","note":"御林猟師町。将軍家に魚を納める漁師が住んだ。鮫が打ち上げられたのが名の由来という。","s":1439.91,"x":-72.66,"y":15.89,"z":1403.35,"snapError":0.8},{"at":[35.6,139.7381],"name":"浜川橋","kana":"はまかわばし","kind":"bridge","bridge":{"radiusM":9,"riseM":0.55},"lookHint":"左手はすぐ海","note":"立会川に架かる橋。鈴ヶ森へ送られる罪人と身内がここで今生の別れをしたので、涙橋とも呼ばれた。","s":2069.9,"x":-278.87,"y":2.6,"z":1998.51,"snapError":5.5},{"at":[35.5964,139.7366],"name":"鈴ヶ森","kana":"すずがもり","kind":"kosatsu","clearM":60,"clearSide":1,"note":"慶安四年(1651)に設けられた刑場。丸橋忠弥がここで最初に処された。街道のすぐ脇、波の寄せる松原にあり、旅人は否応なく目にすることになる。","s":2504.9,"x":-418.22,"y":2.47,"z":2410.48,"snapError":6.3},{"at":[35.5904,139.734],"name":"大森","kana":"おおもり","kind":"town","note":"海苔の産地。遠浅の海に篊（ひび）を立てて海苔を採り、江戸へ運んだ。街道には海苔を商う店が並ぶ。","s":3209.9,"x":-652.59,"y":1.9,"z":3075.25,"snapError":3},{"at":[35.5822,139.7305],"name":"美原通り","kana":"みはらどおり","kind":"view","note":"北原・中原・南原の三つの原を貫く街道。松並木が続き、右手は畑、左手は海へ下る低地である。","s":4169.89,"x":-967.19,"y":2.33,"z":3982.11,"snapError":3.3},{"at":[35.5675,139.725],"name":"蒲田","kana":"かまた","kind":"town","note":"蒲の生える田から出た名という。街道の左右は一面の田で、麦と米を作る在方の村である。","s":5879.89,"x":-1464.97,"y":2.68,"z":5617.84,"snapError":3.9},{"at":[35.5486,139.7118],"name":"六郷神社","kana":"ろくごうじんじゃ","kind":"temple","gateway":{"width":12,"height":9,"side":-1},"note":"源頼義・義家が奥州へ向かう途中、ここで勝ちを祈って旗を立てたと伝わる八幡。梶原景時の寄進という石橋が残る。","s":8339.83,"x":-2660.98,"y":2.87,"z":7726.18,"snapError":0.8},{"at":[35.5423,139.7065],"name":"六郷の渡し","kana":"ろくごうのわたし","kind":"watashi","lookHint":"渡し船を待つ。舟が来るまで動けぬ","note":"多摩川の渡船場。慶長五年(1600)に架けられた六郷大橋は貞享五年(1688)の洪水で流され、以後は舟で渡る。増水すれば川留めとなり、旅人は幾日も足止めされた。","s":9194.81,"x":-3142.08,"y":2.74,"z":8431.08,"snapError":4.6},{"at":[35.5352,139.7028],"name":"川崎宿","kana":"かわさきしゅく","kind":"post","note":"元和九年(1623)、品川と神奈川のあいだが遠すぎるとして新たに立てられた宿。渡しの待ちで旅人が滞るので、旅籠は早くから栄えた。","s":10049.15,"x":-3474.95,"y":3.03,"z":9217.25,"snapError":0}]}