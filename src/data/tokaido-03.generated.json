3,-3.3,-1,1,1,1.3,1.3,1,0.7,0.7,0.7,1,1,1.2,2.2]},"landmarks":[{"at":[35.5333,139.7033],"name":"川崎宿","kana":"かわさきしゅく","kind":"origin","note":"東海道の第二宿。元和九年(1623)、品川と神奈川のあいだが遠すぎるとして新たに立てられた。六郷の渡しの待ちで旅人が滞るので旅籠が栄えた。ここの問屋場で荷を継ぐ。","s":0,"x":0,"y":3.02,"z":0,"snapError":0},{"at":[35.5262,139.6929],"name":"八丁畷","kana":"はっちょうなわて","kind":"view","grove":{"count":18,"side":0,"spanM":200,"heightM":[9,13],"nearM":[2.5,7]},"lookHint":"左右は一面の田。八丁の一本道","note":"畷とは田の中を貫く一本道のこと。川崎宿の京方はずれから八丁（約870m）にわたって、左右に田をひろげたまま道がまっすぐ続く。ここで大師河原への道が分かれる。","s":1304.7,"x":-939.3,"y":1.73,"z":790.02,"snapError":2.8},{"at":[35.5178,139.6876],"name":"市場一里塚","kana":"いちばいちりづか","kind":"kosatsu","clearM":30,"note":"日本橋から五里目の一里塚。街道の両側に塚を築き榎を植えた。江戸を出て五つ目の塚である。","s":2382.34,"x":-1426.43,"y":1.4,"z":1726.48,"snapError":4.3},{"at":[35.51265,139.68628],"name":"鶴見橋","kana":"つるみばし","kind":"bridge","bridge":{"radiusM":12,"riseM":0.85},"note":"鶴見川に架かる橋。多摩川と違ってこちらは橋が架かっており、舟を待たずに渡れる。橋の袂には茶屋が出て、名物の米饅頭を売った。","s":3100.21,"x":-1538.09,"y":2.74,"z":2293,"snapError":6.9},{"at":[35.5085,139.6823],"name":"鶴見","kana":"つるみ","kind":"town","note":"鶴見川の南に開けた村。杉山大明神を祀る。街道の左手はもう海で、潮の香が道まで届く。","s":3700.19,"x":-1906,"y":1.69,"z":2764.88,"snapError":5.5},{"at":[35.4944,139.6685],"name":"生麦","kana":"なまむぎ","kind":"town","lookHint":"左手はすぐ海。江戸へ運ぶ魚が揚がる","note":"漁村。ここで揚がる魚は活きたまま江戸へ運ばれ、生麦の魚として高く売れた。街道と海のあいだに漁師の家が並ぶ。","s":5710.11,"x":-3153.73,"y":2.49,"z":4331.74,"snapError":1.9},{"at":[35.484,139.6455],"name":"子安","kana":"こやす","kind":"town","note":"海沿いの村。街道の左は浅い入江で、海苔と貝を採った。ここまで来れば神奈川宿は近い。","s":8139.93,"x":-5239.92,"y":6.35,"z":5490.16,"snapError":4.4},{"at":[35.475,139.6324],"name":"神奈川宿","kana":"かながわしゅく","kind":"post","note":"東海道の第三宿。神奈川湊を抱える湊町で、江戸へ向かう船と街道の荷がここで行き交う。旅籠は東海道でも指折りの数を数えた。","s":9709.04,"x":-6422.78,"y":4.76,"z":6489.93,"snapError":0}]}